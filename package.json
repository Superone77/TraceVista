{
  "name": "trajactory-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --config viewer/vite.config.ts --host 127.0.0.1 --port 8875 --strictPort",
    "build": "tsc -p viewer/tsconfig.json && vite build --config viewer/vite.config.ts",
    "preview": "vite preview --config viewer/vite.config.ts --host 127.0.0.1 --port 8875 --strictPort",
    "test": "node scripts/test.mjs",
    "setup:hooks": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "@fontsource-variable/inter": "5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.6",
    "typescript": "5.9.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
